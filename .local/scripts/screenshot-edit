#!/bin/bash

set -e

file="${1:-}"

if [[ ! -f "$file" ]]; then
    notify-send \
        --app-name "Screenshot" \
        "Screenshot unavailable" \
        "The temporary screenshot no longer exists."
    exit 1
fi

edited="${file%.png}-edited.png"

swappy -f "$file" -o "$edited"

if [[ -f "$edited" ]]; then
    wl-copy --type image/png < "$edited"
    notify-send \
        --app-name "Screenshot" \
        --icon "$edited" \
        "Screenshot edited" \
        "Edited screenshot was copied to the clipboard."
fi
