#!/bin/bash

set -e

TMP_DIR="${XDG_RUNTIME_DIR:-/tmp}/screenshots"
id="${1:-}"

if [[ -z "$id" ]]; then
    exit 1
fi

mapping="$TMP_DIR/$id"
if [[ ! -f "$mapping" ]] then
    notify-send \
        --app-name "Screenshot" \
        "Screenshot unavailable" \
        "The temporary screenshot no longer exists."
fi

file="$(cat "$mapping")"
if [[ ! -f "$file" ]]; then
    notify-send \
        --app-name "Screenshot" \
        "Screenshot unavailable" \
        "The temporary screenshot no longer exists."
fi

edited="$TMP_DIR/edited-$file.png"

swappy -f "$file" -o "$edited"

if [[ -f "$edited" ]]; then
    wl-copy --type image/png < "$edited"
    notify-send \
        --app-name "Screenshot" \
        --icon "$edited"
        "Screenshot edited" \
        "Edited screenshot was copied to the clipboard."

    mv "$edited" "$file"
fi
