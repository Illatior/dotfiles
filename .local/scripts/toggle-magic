#!/usr/bin/env bash

monitor=$1
if [[ -z $monitor ]]; then
    echo "Usage: $0 <monitor> "
    exit 1
fi
if ! hyprctl monitors -j | jq -e --arg mon "$monitor" '.[] | select(.name == $mon)' > /dev/null; then
    echo "Error: monitor '$monitor' does not exist"
    exit 1
fi

active=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
if [ "$active" != "$1" ]; then
    hyprctl dispatch focusmonitor $monitor
fi

magic=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .specialWorkspace.name')
if [ "$magic" != "special:magic" ]; then # open magic workspace if it's closed
    echo "magic is not active"
    hyprctl dispatch togglespecialworkspace magic
elif [[ "$magic" == "special:magic" && "$active" == "$monitor" ]]; then # close magic if we're currently on it's monitor
    echo "magic + monitor is active"
    hyprctl dispatch togglespecialworkspace magic
fi
